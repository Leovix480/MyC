<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" minHeight="400.0" minWidth="450.0" prefHeight="400.0" prefWidth="450.0" styleClass="raiz" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.myc.Seleccionar_productoController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
         </padding>
         <children>

            <!-- Búsqueda y listado de productos -->
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <TextField fx:id="txtBuscar" maxWidth="Infinity" onKeyReleased="#buscar" prefHeight="26.0" styleClass="campo" />
                  <TableView fx:id="tablaProductos" maxHeight="Infinity" maxWidth="Infinity" onMouseClicked="#mostrarFila" styleClass="tabla" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="columID" minWidth="45.0" prefWidth="55.0" text="ID" />
                        <TableColumn fx:id="columNombre" minWidth="120.0" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="columPrecio" minWidth="80.0" prefWidth="123.0" text="Precio" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- Botón Aceptar alineado a la derecha -->
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="btnAceptar" minWidth="96.0" mnemonicParsing="false" onAction="#aceptar" prefHeight="30.0" prefWidth="96.0" styleClass="boton-acento" text="Aceptar" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
