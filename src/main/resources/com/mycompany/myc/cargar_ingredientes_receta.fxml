<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" minHeight="345.0" minWidth="480.0" prefHeight="345.0" prefWidth="480.0" styleClass="raiz" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.myc.Cargar_ingredientes_recetaController">
   <children>
      <HBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
         </padding>
         <children>

            <!-- Búsqueda y listado de ingredientes con su cantidad en la receta -->
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <TextField fx:id="txtBuscar" maxWidth="Infinity" onKeyReleased="#buscar" prefHeight="26.0" styleClass="campo" />
                  <TableView fx:id="tablaIRecetas" maxHeight="Infinity" maxWidth="Infinity" onMouseClicked="#mostrarFila" styleClass="tabla" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="columNombre" minWidth="100.0" prefWidth="158.0" text="Nombre" />
                        <TableColumn fx:id="columCantidad" minWidth="70.0" prefWidth="108.0" text="Cantidad" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- Panel de controles: Aceptar queda siempre abajo -->
            <VBox minWidth="150.0" prefWidth="150.0" spacing="12.0" styleClass="card">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="14.0" />
               </padding>
               <children>
                  <Label minWidth="-Infinity" styleClass="etiqueta-titulo" text="Cantidad a usar:" />
                  <TextField fx:id="txtCantidad" maxWidth="Infinity" styleClass="campo" />
                  <Button fx:id="btnAdd" maxWidth="Infinity" mnemonicParsing="false" onAction="#add" styleClass="boton" text="Añadir" />
                  <Button fx:id="btnEditar" maxWidth="Infinity" mnemonicParsing="false" onAction="#editar" styleClass="boton" text="Editar" />
                  <Region VBox.vgrow="ALWAYS" />
                  <Button fx:id="btnAceptar" maxWidth="Infinity" mnemonicParsing="false" onAction="#aceptar" styleClass="boton-acento" text="Aceptar" />
               </children>
            </VBox>

         </children>
      </HBox>
   </children>
</AnchorPane>
