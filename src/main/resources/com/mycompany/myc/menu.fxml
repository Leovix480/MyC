<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="650.0" style="-fx-background-color: #FEEBE7; -fx-border-color: #E8A798; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.myc.MenuController">
   <children>

      <!-- Logo -->
      <ImageView fitHeight="210.0" fitWidth="200.0" layoutX="225.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@imagenes/MyC%20logo%201.png" />
         </image>
      </ImageView>

      <!-- Panel principal de navegación -->
      <AnchorPane layoutX="60.0" layoutY="260.0" prefHeight="150.0" prefWidth="530.0" style="-fx-background-color: #FFF6F3; -fx-background-radius: 12; -fx-border-color: #E8A798; -fx-border-width: 1.5; -fx-border-radius: 12;">
         <children>
            <Button fx:id="btnPedidos" layoutX="40.0" layoutY="55.0" mnemonicParsing="false" onAction="#abrirPedidos" prefHeight="34.0" prefWidth="110.0" style="-fx-background-color: #F4C6B8; -fx-border-color: #E8A798; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #5C3A34; -fx-font-weight: bold; -fx-font-size: 12;" text="Pedidos" />
            <Button fx:id="btnRecetas" layoutX="210.0" layoutY="55.0" mnemonicParsing="false" onAction="#abrirRecetas" prefHeight="34.0" prefWidth="110.0" style="-fx-background-color: #F4C6B8; -fx-border-color: #E8A798; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #5C3A34; -fx-font-weight: bold; -fx-font-size: 12;" text="Recetas" />
            <Button fx:id="btnIngredientes" layoutX="380.0" layoutY="55.0" mnemonicParsing="false" onAction="#abrirIngredientes" prefHeight="34.0" prefWidth="110.0" style="-fx-background-color: #F4C6B8; -fx-border-color: #E8A798; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #5C3A34; -fx-font-weight: bold; -fx-font-size: 12;" text="Ingredientes" />
         </children>
      </AnchorPane>

      <!-- Clientes -->
      <Button fx:id="btnClientes" layoutX="60.0" layoutY="430.0" mnemonicParsing="false" onAction="#abrirCliente" prefHeight="32.0" prefWidth="110.0" style="-fx-background-color: #F4C6B8; -fx-border-color: #E8A798; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #5C3A34; -fx-font-weight: bold; -fx-font-size: 12;" text="Clientes" />

      <!-- Cerrar sesión -->
      <Button fx:id="btnCerrar" layoutX="480.0" layoutY="430.0" mnemonicParsing="false" onAction="#cerrar" prefHeight="32.0" prefWidth="110.0" style="-fx-background-color: #D98572; -fx-border-color: #5C3A34; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;" text="Cerrar sesión" />

      <!-- Acerca del sistema -->
      <Label fx:id="lblAcercaDe" layoutX="15.0" layoutY="470.0" style="-fx-text-fill: #5C3A34; -fx-font-size: 11; -fx-underline: true;" text="Acerca del sistema" />

   </children>
</AnchorPane>
