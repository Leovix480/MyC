<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" minHeight="500.0" minWidth="650.0" prefHeight="500.0" prefWidth="650.0" styleClass="raiz" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.myc.MenuController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>

         <!-- Cabecera: logo siempre centrado (StackPane.alignment por defecto = CENTER),
              alerta de stock anclada arriba a la derecha sin afectar el centrado del logo -->
         <top>
            <StackPane minHeight="220.0" BorderPane.alignment="CENTER">
               <children>
                  <!-- Logo -->
                  <ImageView fitHeight="210.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagenes/MyC%20logo%201.png" />
                     </image>
                  </ImageView>

                  <!-- Alerta de stock mínimo (oculta si no hay ingredientes por debajo del mínimo) -->
                  <Label fx:id="lblAlertaStock" alignment="CENTER" maxWidth="200.0" styleClass="alerta-stock" text="Alerta: 0 ingredientes están por debajo del stock mínimo" visible="false" wrapText="true" StackPane.alignment="TOP_RIGHT">
                     <StackPane.margin>
                        <Insets top="10.0" />
                     </StackPane.margin>
                  </Label>
               </children>
            </StackPane>
         </top>

         <!-- Panel principal de navegación -->
         <center>
            <HBox alignment="CENTER" maxHeight="150.0" maxWidth="900.0" minHeight="150.0" spacing="60.0" styleClass="card, card-menu" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="20.0" left="45.0" right="45.0" top="20.0" />
               </BorderPane.margin>
               <children>
                  <Button fx:id="btnPedidos" minWidth="110.0" mnemonicParsing="false" onAction="#abrirPedidos" prefHeight="34.0" prefWidth="110.0" styleClass="boton, boton-menu" text="Pedidos" />
                  <Button fx:id="btnRecetas" minWidth="110.0" mnemonicParsing="false" onAction="#abrirRecetas" prefHeight="34.0" prefWidth="110.0" styleClass="boton, boton-menu" text="Recetas" />
                  <Button fx:id="btnIngredientes" minWidth="110.0" mnemonicParsing="false" onAction="#abrirIngredientes" prefHeight="34.0" prefWidth="110.0" styleClass="boton, boton-menu" text="Ingredientes" />
               </children>
            </HBox>
         </center>

         <!-- Pie: Clientes a la izquierda, Cerrar sesión a la derecha, enlace al manual -->
         <bottom>
            <VBox spacing="8.0">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Button fx:id="btnClientes" minWidth="110.0" mnemonicParsing="false" onAction="#abrirCliente" prefHeight="32.0" prefWidth="110.0" styleClass="boton, boton-menu" text="Clientes" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCerrar" minWidth="110.0" mnemonicParsing="false" onAction="#cerrar" prefHeight="32.0" prefWidth="110.0" styleClass="boton-acento, boton-menu" text="Cerrar sesión" />
                     </children>
                  </HBox>
                  <Label fx:id="lblAcercaDe" onMouseClicked="#abrirManual" styleClass="enlace" text="Acerca del sistema" />
               </children>
            </VBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
